---
// src/pages/index.astro
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Endorsement from '../components/Endorsement.astro';
import AcknowledgmentOfCountry from '../components/AcknowledgmentOfCountry.astro';
import BuyButton from '../components/BuyButton.astro';
import { url } from '../utils/url';

import melbourneCover from '../assets/book-images/melbourne-cover.jpg';
import walksBandImage from '../assets/walks/group-listening.jpg';

const allEndorsements = await getCollection('endorsements');
const featured = allEndorsements.filter(e => e.data.featured);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ACE Guide to Eucalypts',
  url: 'https://realmindsai.github.io/ACE-Guide-to-Eucalypts-Melbourne/',
  description: 'A pocket field guide to Melbourne\'s eucalypt species. Direct from the author & photographer. $30 — Buy Now. Identified by bark, fruit, bud, and leaf, photographed in intimate detail.',
};
---

<Base
  title="ACE Guide to Eucalypts Melbourne"
  description="Know the trees around you. A pocket field guide to Melbourne's eucalypt species. Direct from the author &amp; photographer. $30 — Buy Now. Identified by bark, fruit, bud, and leaf, photographed in intimate detail."
  schemaJson={siteSchema}
>

  <!-- Hero: two-up — Book on the left, Course on the right -->
  <section class="hero">
    <div class="hero-inner wide-width">
      <h1 class="page-title">Know the trees around you</h1>

      <div class="offer-grid">

        <!-- The Book -->
        <a href={url('/melbourne/')} class="offer-card">
          <div class="offer-body">
            <h2 class="offer-label">The Book</h2>
            <p class="offer-desc">A pocket field guide to Melbourne's eucalypt species — identified by bark, fruit, bud, and leaf, photographed in intimate detail.</p>
          </div>
          <div class="offer-image">
            <Image
              src={melbourneCover}
              alt="ACE Guide to Eucalypts Melbourne — softcover field guide"
              width={320}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <span class="offer-cta">Read more &rarr;</span>
        </a>

        <!-- The Course -->
        <a href={url('/course/')} class="offer-card">
          <div class="offer-body">
            <h2 class="offer-label">The Course</h2>
            <p class="offer-desc">Eucalypt Identification &amp; Ecology — an immersive 4-day course with Vicky Shukuroglou &amp; Karl Just. Classroom sessions and field trips across Melbourne's landscapes.</p>
          </div>
          <div class="offer-image">
            <img
              src="/images/course/course-flyer-cover.jpg"
              alt="Eucalypt Identification & Ecology — Immersive 4-day course with Vicky Shukuroglou and Karl Just"
              loading="eager"
            />
          </div>
          <span class="offer-cta">Course info and bookings &rarr;</span>
        </a>

      </div>

      <div class="hero-cta">
        <BuyButton text="Buy the Book — $30 AUD" href="https://buy.stripe.com/00w3cn2Wi7Yq7uf3pXgjC01" external={true} />
        <p class="hero-secure">Secure checkout via Stripe. No account needed.</p>
      </div>
    </div>
  </section>

  <!-- Endorsements -->
  {featured.length > 0 && (
    <section class="section" aria-label="Endorsements">
      <div class="content-width">
        {featured.slice(0, 3).map(e => (
          <Endorsement
            quote={e.data.quote}
            name={e.data.name}
            credential={e.data.credential}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Walks band -->
  <section class="section walks-band">
    <div class="wide-width walks-band-inner">
      <div class="walks-band-image">
        <Image
          src={walksBandImage}
          alt="A group on a guided walk, listening as Vicky points out details of a eucalypt"
          width={640}
          loading="lazy"
        />
      </div>
      <div class="walks-band-text">
        <h2>Walks with Vicky</h2>
        <p>
          Step into the world of eucalypts and discover Melbourne through its most iconic trees.
        </p>
        <p>
          <a href={url('/walks/')} class="buy-button">Book a walk</a>
        </p>
      </div>
    </div>
  </section>

  <!-- What the ACE method is -->
  <section class="section method">
    <div class="content-width">
      <h2>Identified by bark, fruit, bud, and leaf</h2>
      <p>
        Identify trees year-round with a simple, step-by-step method.
      </p>
      <p>
        No botanical training required. Life-scaled photography reveals each detail
        clearly, so you can compare it with the tree in front of you.
      </p>
      <div class="method-links">
        <a href={url('/melbourne/')}>See the Melbourne guide →</a>
      </div>
    </div>
  </section>

  <AcknowledgmentOfCountry />

</Base>

<style>
  /* Hero — compact, so the two offer cards sit high on the page */
  .hero {
    padding-block: var(--space-sm);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    align-items: start;
    text-align: center;
  }

  .page-title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
    margin: 0;
  }

  /* Offer grid — The Book + The Course side by side */
  .offer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    max-width: 900px;
    margin-inline: auto;
    text-align: left;
  }

  @media (min-width: 700px) {
    .offer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 150ms ease;
    align-self: start;
    text-align: center;
  }

  .offer-card:hover {
    transform: translateY(-3px);
  }

  .offer-body {
    margin-bottom: var(--space-sm);
  }

  .offer-label {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .offer-desc {
    color: var(--color-text-secondary);
    line-height: 1.55;
    font-size: 0.95rem;
    margin: 0;
  }

  .offer-image {
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }

  .offer-image img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 6px 28px rgba(44, 44, 42, 0.18);
  }

  .offer-cta {
    color: var(--color-cta);
    font-weight: 600;
  }

  /* CTA row */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    justify-content: center;
  }

  .hero-secure {
    width: 100%;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Walks band */
  .walks-band {
    padding-block: var(--space-lg);
  }

  .walks-band-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    align-items: center;
  }

  @media (min-width: 720px) {
    .walks-band-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .walks-band-image img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 4px 20px rgba(44, 44, 42, 0.15);
  }

  .walks-band-text h2 {
    margin-bottom: var(--space-sm);
  }

  .walks-band-text p {
    margin-bottom: var(--space-sm);
  }

  /* Method section */
  .method {
    background-color: #f0ebe4;
  }

  .method p + p {
    margin-top: var(--space-sm);
  }

  .method-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .method-links a {
    color: var(--color-cta);
    font-weight: 600;
    text-decoration: none;
  }

  .method-links a:hover {
    text-decoration: underline;
  }
</style>
