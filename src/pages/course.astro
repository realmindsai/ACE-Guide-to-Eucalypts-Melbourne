---
// src/pages/course.astro
import Base from '../layouts/Base.astro';
import AcknowledgmentOfCountry from '../components/AcknowledgmentOfCountry.astro';

const breadcrumbs = [{ name: 'The Course', href: '/course/' }];

const infoPdfHref = '/downloads/eucalypt-course-info-2026.pdf';
const enquiryHref =
  'mailto:info@eucalyptsmelbourne.au?subject=Eucalypt%20Identification%20%26%20Ecology%20Course%20enquiry';

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Eucalypt Identification & Ecology',
  description:
    "An immersive 4-day course exploring Melbourne's eucalypts and diverse landscapes through interactive classroom sessions and hands-on field experience. With Vicky Shukuroglou and Karl Just.",
  provider: {
    '@type': 'Organization',
    name: 'ACE Guide to Eucalypts Melbourne',
    url: 'https://eucalyptsmelbourne.au/',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    location: { '@type': 'Place', name: 'Melbourne, Australia' },
    startDate: '2026-10-03',
    endDate: '2026-11-28',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'AUD',
    price: '900',
  },
};

const pillars = [
  { verb: 'Explore', body: 'diverse environments and hands-on learning' },
  { verb: 'Discover', body: 'ecology, evolution and relationships within ecosystems' },
  { verb: 'Identify', body: "Melbourne's eucalypts using practical ID skills" },
  { verb: 'Understand', body: 'geology, soils, climate and landscape' },
];
---

<Base
  title="Eucalypt Identification & Ecology Course — with Vicky Shukuroglou & Karl Just"
  description="An immersive 4-day course exploring Melbourne's eucalypts and diverse landscapes. Interactive classroom sessions and guided field experience across four Saturdays in October and November 2026. With Vicky Shukuroglou and Karl Just."
  schemaJson={courseSchema}
  breadcrumbs={breadcrumbs}
>

  <!-- Hero — image left (small), info + prominent buttons right -->
  <section class="hero">
    <div class="hero-inner content-width">
      <div class="hero-cover">
        <img
          src="/images/course/course-flyer-header.jpg"
          alt="Eucalypt Identification & Ecology — Immersive 4-day course. Tall forest with tree ferns."
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-text">
        <h1>Eucalypt Identification &amp; Ecology</h1>
        <p class="hero-subtitle">
          Interactive classroom sessions and guided field experience across Melbourne's
          diverse landscapes — suitable for all levels of knowledge.
        </p>
        <div class="hero-meta">
          <span>With <strong>Vicky Shukuroglou</strong> &amp; <strong>Karl Just</strong></span>
          <span class="meta-sep">·</span>
          <span>Four Saturdays, October &amp; November 2026</span>
          <span class="meta-sep">·</span>
          <span>$900 · Limited places</span>
        </div>
        <div class="hero-buttons">
          <a class="buy-button buy-button-large" href={enquiryHref}>
            Enquire and register
          </a>
          <a class="buy-button buy-button-large buy-button-secondary" href={infoPdfHref} target="_blank" rel="noopener">
            Download full info (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Four pillars — leaf motif from the flyer -->
  <section class="section pillars-section">
    <div class="wide-width">
      <div class="pillars-grid">
        {pillars.map(({ verb, body }) => (
          <div class="pillar">
            <div class="leaf" aria-hidden="true">
              <svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M10,45 Q30,10 60,15 Q95,20 110,45 Q95,70 60,75 Q30,80 10,45 Z"
                  fill="currentColor"
                  opacity="0.28"
                />
                <path
                  d="M10,45 Q60,42 110,45"
                  stroke="currentColor"
                  stroke-width="1.2"
                  fill="none"
                  opacity="0.55"
                />
              </svg>
            </div>
            <h2 class="pillar-verb">{verb}</h2>
            <p class="pillar-body">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AcknowledgmentOfCountry />
</Base>

<style>
  /* Hero — mirrors melbourne.astro book page */
  .hero {
    padding-block: var(--space-lg);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (max-width: 700px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-cover {
      max-width: 260px;
      margin-inline: auto;
    }
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 6px 32px rgba(44, 44, 42, 0.2);
  }

  .hero-text h1 {
    margin-bottom: var(--space-sm);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .hero-meta {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    align-items: center;
  }

  @media (max-width: 700px) {
    .hero-meta { justify-content: center; }
  }

  .meta-sep {
    margin-inline: 0.5rem;
    color: var(--color-olive);
  }

  /* Prominent buttons */
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  @media (max-width: 700px) {
    .hero-buttons { justify-content: center; }
  }

  .buy-button-large {
    font-size: 1.1rem;
    padding: 1rem 2rem;
    min-height: 56px;
  }

  .buy-button-secondary {
    background-color: transparent;
    color: var(--color-cta);
    border: 2px solid var(--color-cta);
  }

  .buy-button-secondary:hover {
    background-color: var(--color-cta);
    color: var(--color-bg);
  }

  /* Pillars — leaf motif */
  .pillars-section {
    padding-block: var(--space-lg);
    background-color: #f0ebe4;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 860px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 460px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }

  .pillar {
    position: relative;
    padding: var(--space-md) var(--space-sm);
    text-align: center;
    color: var(--color-green, #3a5a3a);
  }

  .leaf {
    width: 120px;
    height: 90px;
    margin-inline: auto;
    color: var(--color-green, #3a5a3a);
    margin-bottom: var(--space-xs);
  }

  .leaf svg { display: block; width: 100%; height: 100%; }

  .pillar-verb {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-green, #3a5a3a);
    margin-bottom: var(--space-xs);
  }

  .pillar-body {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 22ch;
    margin-inline: auto;
  }
</style>
