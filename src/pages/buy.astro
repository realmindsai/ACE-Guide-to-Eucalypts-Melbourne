---
// src/pages/buy.astro
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';

import melbourneCover from '../assets/book-images/melbourne-cover.jpg';

const breadcrumbs = [{ name: 'Buy', href: '/buy/' }];

const melbourneStripeLink = 'https://buy.stripe.com/00w3cn2Wi7Yq7uf3pXgjC01';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'ACE Guide to Eucalypts Melbourne',
  author: [
    { '@type': 'Person', name: 'Vicky Shukuroglou' },
    { '@type': 'Person', name: 'Roderick Fensham' },
  ],
  isbn: '9780645232615',
  publisher: { '@type': 'Organization', name: 'ACE Publishing' },
  description: "A field guide to Melbourne's 36 eucalypt species, identified by bark, fruit, bud, and leaf.",
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'AUD',
    price: '30',
    url: melbourneStripeLink,
  },
};

---

<Base
  title="Buy the ACE Guide to Eucalypts Melbourne"
  description="Purchase the ACE Guide to Eucalypts Melbourne. $30 + $7.50 postage &amp; handling. Secure Stripe checkout."
  schemaJson={pageSchema}
  breadcrumbs={breadcrumbs}
>

  <!-- Hero: mirrors the book page hero -->
  <section class="hero">
    <div class="hero-inner content-width">
      <div class="hero-cover">
        <a href={melbourneStripeLink} target="_blank" rel="noopener" aria-label="Click for secure payment via Stripe">
          <Image
            src={melbourneCover}
            alt="Cover of the ACE Guide to Eucalypts Melbourne — eucalypt bark peeling in layers of grey, white, and rust"
            width={280}
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>
      <div class="hero-text">
        <h1>36 eucalypt species, one compact book.</h1>
        <p class="hero-subtitle">
          The eucalypts of greater Melbourne — identified by bark, fruit, bud,
          and leaf, photographed in intimate detail.
        </p>
        <div class="hero-meta">
          <span>Vicky Shukuroglou &amp; Rod Fensham</span>
          <span class="meta-sep">·</span>
          <span>Softcover, 56 pp</span>
          <span class="meta-sep">·</span>
          <span>$30 AUD + $7.50 postage &amp; handling (Australia)</span>
        </div>
        <BuyButton text="Click for secure payment" href={melbourneStripeLink} external={true} />
        <p class="hero-secure">Secure checkout via Stripe. No account needed.</p>
      </div>
    </div>
  </section>

  <!-- Book facts + bookshop / wholesale / gift info -->
  <section class="buy-details section">
    <div class="content-width">
      <dl class="book-facts">
        <dt>ISBN</dt>
        <dd>9780645232615</dd>
      </dl>

      <div class="buy-shared">
        <p class="buy-indie">
          Or ask your local bookshop — they can order it by ISBN.
        </p>

        <p class="buy-contact">
          Wholesale or bulk orders? Email <a href="mailto:info@eucalyptsmelbourne.au">info@eucalyptsmelbourne.au</a>.
        </p>

        <p class="buy-gift">
          Know someone who walks in the bush? It makes a meaningful gift.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero — mirrors melbourne.astro */
  .hero {
    padding-block: var(--space-lg);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (max-width: 700px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-cover {
      max-width: 240px;
      margin-inline: auto;
    }
  }

  .hero-cover a {
    display: block;
  }

  .hero-cover img {
    width: 100%;
    border-radius: 0;
    box-shadow: 0 6px 32px rgba(44, 44, 42, 0.2);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .hero-cover a:hover img {
    transform: translateY(-3px);
    box-shadow: 0 10px 36px rgba(44, 44, 42, 0.28);
  }

  .hero h1 {
    margin-bottom: var(--space-xs);
  }

  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .hero-meta {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    align-items: center;
  }

  @media (max-width: 700px) {
    .hero-meta { justify-content: center; }
  }

  .meta-sep {
    margin-inline: 0.5rem;
    color: var(--color-olive);
  }

  .hero-secure {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  /* Book facts + extras */
  .buy-details {
    padding-top: 0;
  }

  .book-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-md);
    max-width: 480px;
  }

  .book-facts dt {
    font-weight: 600;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .buy-shared {
    border-top: 1px solid var(--color-olive);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
  }

  .buy-indie {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .buy-contact {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  .buy-gift {
    margin-top: var(--space-sm);
    font-style: italic;
    color: var(--color-text-secondary);
  }
</style>
